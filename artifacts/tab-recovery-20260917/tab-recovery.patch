+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.EnumSet;
+import java.util.List;
+import java.util.UUID;
+
+import static com.github.retrooper.packetevents.wrapper.play.server.WrapperPlayServerPlayerInfoUpdate.Action.*;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class CustomTablistLayoutTest {
+    private final CustomTablistLayout layout = new CustomTablistLayout(null, null);
+    private final YamlConfiguration cfg = new YamlConfiguration();
+    private Player viewer;
+
+    @BeforeEach
+    void setup() throws Exception {
+        field("packetTablistManager", new PacketTablistManager());
+        field("papiLookupAttempted", true);
+        viewer = player(0);
+        for (String column : List.of("left", "center", "right")) {
+            cfg.set("tab.two-column-layout.top-" + column + ".texts",
+                    List.of("<red>Top " + column + "</red>\nseparator", "<blue>Top " + column + "</blue>\nseparator"));
+            cfg.set("tab.two-column-layout.bottom-" + column + ".texts", List.of("separator\nBottom " + column));
+        }
+    }
+
+    @Test
+    void animationKeepsDecorationsInsideColumnsAndSlotIdsStable() throws Exception {
+        var first = slots(2, 2);
+        field("currentFrame", 1);
+        var second = slots(2, 2);
+        assertEquals(40, first.size());
+        assertEquals("Top left", text(first.get(0)));
+        assertEquals("Top right", text(first.get(20)));
+        assertEquals("Bottom left", text(first.get(19)));
+        assertEquals("Bottom right", text(first.get(39)));
+        assertEquals(first.stream().map(PacketTablistManager.TabSlot::uuid).toList(),
+                second.stream().map(PacketTablistManager.TabSlot::uuid).toList());
+        assertNotEquals(first.get(0).displayName(), second.get(0).displayName());
+        assertEquals(first.get(2).displayName(), second.get(2).displayName());
+    }
+
+    @Test
+    void playersAppearOnceWithoutGapsOrDuplicatesAtColumnBoundaries() throws Exception {
+        for (int columns = 1; columns <= 3; columns++) {
+            for (int count : List.of(1, 2, 17, 31, 33, 48, 55)) {
+                List<String> names = slots(count, columns).stream().map(CustomTablistLayoutTest::text)
+                        .filter(s -> s.startsWith("Player")).toList();
+                assertEquals(Math.min(count, columns * 16), names.size());
+                assertEquals(names.size(), names.stream().distinct().count());
+                for (int i = 0; i < names.size(); i++) assertEquals("Player" + i, names.get(i));
+            }
+        }
+    }
+
+    @Test
+    void expansionIncludesEveryColumnsDecorationSpace() throws Exception {
+        assertEquals(1, columns(16));
+        assertEquals(2, columns(17));
+        assertEquals(2, columns(32));
+        assertEquals(3, columns(33));
+        cfg.set("tab.two-column-layout.top-right.texts", List.of("1\n2\n3\n4\n5\n6"));
+        assertEquals(3, columns(25));
+    }
+
+    @Test
+    void differentFrameHeightsDoNotMovePlayers() throws Exception {
+        cfg.set("tab.two-column-layout.top-left.texts", List.of("short", "one\ntwo\nthree"));
+        assertEquals("Player0", text(slots(1, 1).get(3)));
+        field("currentFrame", 1);
+        assertEquals("Player0", text(slots(1, 1).get(3)));
+    }
+
+    @Test
+    void headerDoesNotStackColumnDecorations() throws Exception {
+        cfg.set("tab.two-column-layout.border", "Border");
+        cfg.set("tab.two-column-layout.header-title-texts", List.of("Title"));
+        cfg.set("tab.two-column-layout.footer", "Footer");
+        var types = new Class<?>[]{Player.class, FileConfiguration.class, int.class};
+        assertEquals("Border\nTitle", plain((Component) invoke("buildTwoColHeader", types, viewer, cfg, 2)));
+        assertEquals("Footer", plain((Component) invoke("buildTwoColFooter", types, viewer, cfg, 2)));
+    }
+
+    @Test
+    @SuppressWarnings({"unchecked", "rawtypes"})
+    void delistingRetainsProfilesAndActionsInMixedPackets() {
+        var real = new WrapperPlayServerPlayerInfoUpdate.PlayerInfo(new UserProfile(UUID.randomUUID(), "Real"));
+        var fake = new WrapperPlayServerPlayerInfoUpdate.PlayerInfo(new UserProfile(PacketTablistManager.colSlotUuid(0, 0), "Fake"));
+        var packet = mock(WrapperPlayServerPlayerInfoUpdate.class);
+        when(packet.getActions()).thenReturn(EnumSet.of(ADD_PLAYER, INITIALIZE_CHAT, UPDATE_LISTED));
+        when(packet.getEntries()).thenReturn(List.of(real, fake));
+        assertTrue(CustomTablistLayout.hideRealPlayerListings(packet));
+        ArgumentCaptor<List> entries = ArgumentCaptor.forClass(List.class);
+        verify(packet).setEntries(entries.capture());
+        var hidden = (WrapperPlayServerPlayerInfoUpdate.PlayerInfo) entries.getValue().get(0);
+        assertFalse(hidden.isListed());
+        assertTrue(real.isListed(), "shared original must not be mutated");
+        assertSame(real.getGameProfile(), hidden.getGameProfile());
+        assertSame(fake, entries.getValue().get(1));
+        assertTrue(fake.isListed());
+        verify(packet, never()).setActions(any());
+    }
+
+    @Test
+    void textAndChatUpdatesPassThrough() {
+        var packet = mock(WrapperPlayServerPlayerInfoUpdate.class);
+        when(packet.getActions()).thenReturn(EnumSet.of(UPDATE_DISPLAY_NAME, INITIALIZE_CHAT));
+        assertFalse(CustomTablistLayout.hideRealPlayerListings(packet));
+        verify(packet, never()).setEntries(any());
+    }
+
+    private Player player(int i) {
+        Player player = mock(Player.class);
+        World world = mock(World.class);
+        when(world.getName()).thenReturn("world");
+        when(player.getWorld()).thenReturn(world);
+        when(player.getUniqueId()).thenReturn(new UUID(0, i + 1));
+        when(player.getName()).thenReturn("Player" + i);
+        when(player.getDisplayName()).thenReturn("Player" + i);
+        return player;
+    }
+
+    private List<Object> players(int count) throws Exception {
+        var type = Class.forName(CustomTablistLayout.class.getName() + "$PlayerTabEntry");
+        var constructor = type.getDeclaredConstructor(Player.class, int.class, String.class);
+        constructor.setAccessible(true);
+        List<Object> result = new ArrayList<>();
+        for (int i = 0; i < count; i++) result.add(constructor.newInstance(player(i), 0, "Player" + i));
+        return result;
+    }
+
+    @SuppressWarnings("unchecked")
+    private List<PacketTablistManager.TabSlot> slots(int count, int columns) throws Exception {
+        return (List<PacketTablistManager.TabSlot>) invoke("buildMultiColumnTabSlots",
+                new Class<?>[]{Player.class, FileConfiguration.class, List.class, int.class, int.class},
+                viewer, cfg, players(count), count, columns);
+    }
+
+    private int columns(int count) throws Exception {
+        return (int) invoke("computeDynamicColumns",
+                new Class<?>[]{FileConfiguration.class, List.class, int.class, int.class}, cfg, players(count), 1, 3);
+    }
+
+    private Object invoke(String name, Class<?>[] types, Object... args) throws Exception {
+        Method method = CustomTablistLayout.class.getDeclaredMethod(name, types);
+        method.setAccessible(true);
+        return method.invoke(layout, args);
+    }
+
+    private void field(String name, Object value) throws Exception {
+        Field field = CustomTablistLayout.class.getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(layout, value);
+    }
+
+    private static String plain(Component component) { return PlainTextComponentSerializer.plainText().serialize(component); }
+    private static String text(PacketTablistManager.TabSlot slot) { return plain(slot.displayName()).trim(); }
+}
